<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- BRAND HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ PHOTONSYNC"
            android:textColor="@color/mauve"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Ambient Screen &amp; Voice-Reactive BLE Engine"
            android:textColor="@color/subtext"
            android:textSize="12sp" />

        <!-- LIVE STATUS CARD -->
        <LinearLayout
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <View
                android:id="@+id/swatch"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/subtext"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- START / STOP -->
        <Button
            android:id="@+id/sync_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:stateListAnimator="@null"
            android:textColor="@color/crust"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- SELECTED STRIP -->
        <Button
            android:id="@+id/strip_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- MICROPHONE TOGGLE -->
        <Button
            android:id="@+id/mic_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:stateListAnimator="@null"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- AUTO-RESUME AFTER UNLOCK (display-over-apps permission + PROJECT_MEDIA grant) -->
        <Button
            android:id="@+id/auto_resume_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:stateListAnimator="@null"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- VOICE COMMAND GUIDE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="🎙️ Voice Engine Syntax"
                android:textColor="@color/mauve"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• Power:  &quot;On&quot; / &quot;Off&quot;\n• Modes:  &quot;Sync&quot; / &quot;Normal&quot;\n• Levels:  &quot;Low&quot; / &quot;Medium&quot; / &quot;High&quot;\n• Colors:  &quot;Red&quot;, &quot;Cyan&quot;, &quot;Purple&quot;, &quot;Pink&quot;…"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- BRIGHTNESS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💡 Master Brightness"
                    android:textColor="@color/mauve"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/brightness_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/blue"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressBackgroundTint="@color/surface0"
                android:progressTint="@color/mauve"
                android:thumbTint="@color/mauve" />
        </LinearLayout>

        <!-- SYSTEM TELEMETRY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💻 System Telemetry"
                android:textColor="@color/subtext"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:background="@color/crust"
                android:padding="8dp">

                <TextView
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/green"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
