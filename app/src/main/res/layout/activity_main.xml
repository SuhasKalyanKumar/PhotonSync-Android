<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base">

    <me.suhaskalyan.photonsync.AuroraView
        android:id="@+id/aurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/michroma"
                android:letterSpacing="0.45"
                android:text="PHOTONSYNC"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <!-- LIVE COLOUR -->
            <me.suhaskalyan.photonsync.OrbView
                android:id="@+id/orb"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/hex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/subtext"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="20dp" />

            <!-- START / STOP -->
            <Button
                android:id="@+id/sync_button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:fontFamily="@font/michroma"
                android:letterSpacing="0.3"
                android:stateListAnimator="@null"
                android:textSize="14sp" />

            <!-- SELECTED STRIP -->
            <Button
                android:id="@+id/strip_button"
                style="@style/GlassButton"
                android:layout_marginTop="10dp" />

            <!-- STRIP TIMER -->
            <Button
                android:id="@+id/timer_button"
                style="@style/GlassButton"
                android:layout_marginTop="8dp" />

            <!-- MICROPHONE TOGGLE -->
            <Button
                android:id="@+id/mic_button"
                style="@style/GlassButton"
                android:layout_marginTop="8dp" />

            <!-- BRIGHTNESS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.2"
                    android:text="LIGHT"
                    android:textColor="@color/subtext"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/brightness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressBackgroundTint="@color/surface0"
                    android:progressTint="@color/mauve"
                    android:thumbTint="@color/mauve" />

                <TextView
                    android:id="@+id/brightness_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- VOICE HELP AND LOGS, TUCKED AWAY -->
            <TextView
                android:id="@+id/details_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.2"
                android:padding="10dp"
                android:text="DETAILS"
                android:textColor="@color/subtext"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="Say  &quot;On&quot;  &quot;Off&quot;  &quot;Sync&quot;  &quot;Low&quot;  &quot;Medium&quot;  &quot;High&quot;\nor a colour like  &quot;Red&quot;  &quot;Cyan&quot;  &quot;Purple&quot;\nSay  &quot;Rainbow&quot;  for a slow colour glide, and  &quot;Sync&quot;  to go back"
                    android:textColor="@color/subtext"
                    android:textSize="12sp" />

                <ScrollView
                    android:id="@+id/log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="true">

                    <TextView
                        android:id="@+id/log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/subtext"
                        android:textIsSelectable="true"
                        android:textSize="10sp" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
