<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PhotonSync" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/base</item>
        <item name="android:statusBarColor">@color/base</item>
        <item name="android:navigationBarColor">@color/base</item>
        <item name="android:colorAccent">@color/mauve</item>
        <item name="android:fontFamily">@font/photon_text</item>
    </style>

    <style name="GlassButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/photon_text</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Invisible host for the resume-after-unlock consent dialog -->
    <style name="Theme.PhotonSync.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
