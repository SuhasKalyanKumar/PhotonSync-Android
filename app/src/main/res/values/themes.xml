<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PhotonSync" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/base</item>
        <item name="android:statusBarColor">@color/base</item>
        <item name="android:navigationBarColor">@color/base</item>
        <item name="android:colorAccent">@color/mauve</item>
    </style>

    <!-- Invisible host for the resume-after-unlock consent dialog -->
    <style name="Theme.PhotonSync.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
